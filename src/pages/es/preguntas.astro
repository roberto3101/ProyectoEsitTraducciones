---
import Principal from '../../layout/Principal.astro';
import ListaPreguntas from '../../componentes/preguntas/ListaPreguntas.astro';
import BannerCotizar from '../../componentes/inicio/BannerCotizar.astro';
import DatosPreguntas from '../../componentes/seo/DatosPreguntas.astro';
import MigasDePan from '../../componentes/seo/MigasDePan.astro';
import { obtenerTextos } from '../../helpers/idiomas';
const t = obtenerTextos('es');
---
<Principal titulo={t.seo.preguntas.titulo} descripcion={t.seo.preguntas.descripcion} idioma="es" pagina="preguntas">
  <DatosPreguntas preguntas={t.preguntas.items} />
  <MigasDePan items={[
    { nombre: 'Inicio', url: '/es/' },
    { nombre: 'Preguntas Frecuentes', url: '/es/preguntas' },
  ]} />
  <ListaPreguntas idioma="es" />
  <BannerCotizar idioma="es" />
</Principal>
