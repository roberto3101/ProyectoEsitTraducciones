---
import Principal from '../../layout/Principal.astro';
import Formulario from '../../componentes/contacto/Formulario.astro';
import InfoContacto from '../../componentes/contacto/InfoContacto.astro';
import { obtenerTextos } from '../../helpers/idiomas';
const t = obtenerTextos('en');
---
<Principal titulo={t.seo.contacto.titulo} descripcion={t.seo.contacto.descripcion} idioma="en" pagina="contacto">
  <section class="cabecera-pagina">
    <div class="contenedor">
      <h1 class="cabecera-titulo">Get in Touch</h1>
      <p class="cabecera-bajada">
        We're ready to help with your project. Tell us what you need and we'll respond within 24 hours.
      </p>
    </div>
  </section>

  <section class="contacto-cuerpo">
    <div class="contenedor contacto-rejilla">
      <div class="contacto-formulario" data-revelar>
        <Formulario idioma="en" />
      </div>
      <div data-revelar="lateral-der">
        <InfoContacto idioma="en" />
      </div>
    </div>
  </section>

  <style>
    .contacto-cuerpo {
      padding-block: clamp(2.5rem, 2rem + 2vw, 4rem) clamp(4rem, 3rem + 4vw, 7rem);
    }
    .contacto-rejilla {
      display: grid;
      gap: 2rem;
      align-items: start;
    }
    @media (min-width: 950px) {
      .contacto-rejilla {
        grid-template-columns: 1.4fr 1fr;
        gap: 3rem;
      }
    }
    .contacto-formulario {
      padding: clamp(1.75rem, 1.5rem + 1.5vw, 2.5rem);
      border: 1px solid var(--borde);
      border-radius: var(--radio-grande);
      background-color: var(--superficie);
    }
  </style>
</Principal>