---
import Principal from '../../layout/Principal.astro';
import ListaArticulos from '../../componentes/blog/ListaArticulos.astro';
import FiltroCategoria from '../../componentes/blog/FiltroCategoria.astro';
import { obtenerTextos } from '../../helpers/idiomas';
import { obtenerArticulosPaginados, obtenerCategorias } from '../../helpers/sanity';

const t = obtenerTextos('en');
const categoriaActual = Astro.url.searchParams.get('cat') || '';
const paginaParam = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1') || 1);

let articulos: any[] = [];
let categorias: string[] = [];
let pagina = 1;
let totalPaginas = 1;

try {
  const [resultado, cats] = await Promise.all([
    obtenerArticulosPaginados('en', paginaParam, categoriaActual),
    obtenerCategorias('en'),
  ]);
  articulos = resultado.articulos;
  pagina = resultado.pagina;
  totalPaginas = resultado.totalPaginas;
  categorias = cats;
} catch (e) {
  console.error('Error fetching articles from Sanity:', e);
}
---
<Principal titulo={t.seo.blog.titulo} descripcion={t.seo.blog.descripcion} idioma="en" pagina="blog">
  <section class="blog-cabecera">
    <div class="contenedor">
      <h1 class="blog-titulo">{t.blog.titulo}</h1>
      <p class="blog-bajada">{t.blog.subtitulo}</p>
      <FiltroCategoria idioma="en" categorias={categorias} categoriaActual={categoriaActual} />
    </div>
  </section>
  <ListaArticulos idioma="en" articulos={articulos} pagina={pagina} totalPaginas={totalPaginas} categoriaActual={categoriaActual} />
</Principal>
