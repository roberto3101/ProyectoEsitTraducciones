---
import { obtenerTextos, obtenerRutas, type Idioma } from '../../helpers/idiomas';
import { servicios, textosServicios, obtenerRutaServicio, type Servicio } from '../../datos/servicios';

interface Props {
  idioma: Idioma;
  servicio: Servicio;
}

const { idioma, servicio } = Astro.props;
const t = obtenerTextos(idioma);
const rutas = obtenerRutas(idioma);
const txt = textosServicios;

const otrosServicios = servicios.filter((s) => s.id !== servicio.id);
const indice = servicios.findIndex((s) => s.id === servicio.id) + 1;
const total = String(servicios.length).padStart(2, '0');
const foto = `/imagenes/servicios/${servicio.id}`;
---

<article class="det">
  <div class="contenedor">
    <a href={rutas.servicios} class="det-volver">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M19 12H5M11 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      {txt.volver[idioma]}
    </a>

    <header class="det-cabecera">
      <p class="det-indice">
        <span class="cifra">{String(indice).padStart(2, '0')}</span>
        <span class="det-indice-barra"></span>
        <span class="cifra det-indice-total">{total}</span>
      </p>
      <h1 class="det-titulo">{servicio.titulo[idioma]}</h1>
      <p class="det-sub">{servicio.subtitulo[idioma]}</p>

      <div class="det-acciones">
        <a href={rutas.contacto} class="boton-principal">{txt.ctaBoton[idioma]}</a>
        <a href="https://wa.me/51998152086" target="_blank" rel="noopener noreferrer" class="boton-secundario">
          WhatsApp
        </a>
      </div>
    </header>

    <figure class="det-foto" data-revelar>
      <picture>
        <source srcset={`${foto}.webp`} type="image/webp" />
        <img src={`${foto}.jpg`} alt={servicio.titulo[idioma]} width="1400" height="933" loading="eager" decoding="async" />
      </picture>
    </figure>

    <div class="det-rejilla">
      <div class="det-principal">
        <p class="det-desc" data-revelar>{servicio.descripcion[idioma]}</p>

        <section class="det-bloque" data-revelar>
          <h2 class="det-rotulo">{txt.especialidades[idioma]}</h2>
          <ul class="det-lista">
            {servicio.especialidades[idioma].map((esp: string) => (
              <li>{esp}</li>
            ))}
          </ul>
        </section>

        <section class="det-bloque" data-revelar>
          <h2 class="det-rotulo">{txt.sectores[idioma]}</h2>
          <ul class="det-sectores">
            {servicio.sectores[idioma].map((sec: string) => (
              <li>{sec}</li>
            ))}
          </ul>
        </section>
      </div>

      <aside class="det-lado">
        <div class="det-otros">
          <h2 class="det-rotulo">{txt.otrosServicios[idioma]}</h2>
          <ul>
            {otrosServicios.map((otro) => (
              <li>
                <a href={obtenerRutaServicio(otro, idioma)} class="det-otro">
                  <span class="det-otro-texto">
                    <span class="det-otro-nombre">{otro.titulo[idioma]}</span>
                    <span class="det-otro-sub">{otro.subtitulo[idioma]}</span>
                  </span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </div>
</article>

<style>
  .det {
    padding-block: 2rem clamp(4rem, 3rem + 4vw, 7rem);
  }

  .det-volver {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Sora', sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--texto-tenue);
    text-decoration: none;
    transition: color var(--ms-ui) var(--sale);
  }
  .det-volver svg {
    width: 1rem;
    height: 1rem;
    transition: transform var(--ms-ui) var(--sale);
  }
  .det-volver:hover {
    color: var(--texto);
  }
  .det-volver:hover svg {
    transform: translateX(-0.25rem);
  }

  .det-cabecera {
    padding-block: clamp(2rem, 1.5rem + 2vw, 3.5rem) clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .det-indice {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: 'Sora', sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--texto-tenue);
  }
  .det-indice-barra {
    width: 2rem;
    height: 1px;
    background-color: var(--ambar);
  }
  .det-indice-total {
    opacity: 0.55;
  }

  .det-titulo {
    margin-top: 1.25rem;
    font-family: 'Sora', sans-serif;
    font-size: clamp(2rem, 1.6rem + 1.9vw, 3.25rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: var(--navy);
    max-width: 20ch;
  }
  :global(.dark) .det-titulo {
    color: var(--texto);
  }

  .det-sub {
    margin-top: 0.875rem;
    max-width: 48ch;
    font-family: 'Sora', sans-serif;
    font-size: var(--t-guia);
    font-weight: 500;
    color: var(--acento);
  }

  .det-acciones {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .det-foto {
    aspect-ratio: 21 / 9;
    overflow: hidden;
    border-radius: var(--radio-grande);
    background-color: var(--fondo-hundido);
  }
  .det-foto picture,
  .det-foto img {
    display: block;
    width: 100%;
    height: 100%;
  }
  .det-foto img {
    object-fit: cover;
  }

  .det-rejilla {
    display: grid;
    gap: 3rem;
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  @media (min-width: 950px) {
    .det-rejilla {
      grid-template-columns: 1fr 20rem;
      gap: 5rem;
      align-items: start;
    }
  }

  .det-desc {
    max-width: 62ch;
    font-size: var(--t-guia);
    line-height: 1.8;
    color: var(--texto-medio);
  }

  .det-bloque {
    margin-top: 3rem;
  }

  .det-rotulo {
    font-family: 'Sora', sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--texto-tenue);
  }

  .det-lista {
    margin-top: 1rem;
    display: grid;
    list-style: none;
  }

  @media (min-width: 600px) {
    .det-lista {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2.5rem;
    }
  }

  .det-lista li {
    padding-block: 0.625rem;
    border-top: 1px solid var(--borde);
    font-size: 0.9375rem;
    color: var(--texto-medio);
  }

  .det-sectores {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
  }

  .det-sectores li {
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--borde-marcado);
    border-radius: 999px;
    font-size: 0.8125rem;
    color: var(--texto-medio);
  }

  @media (min-width: 950px) {
    .det-lado {
      position: sticky;
      top: 7rem;
    }
  }

  .det-otros ul {
    margin-top: 1rem;
    list-style: none;
  }

  .det-otro {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
    border-top: 1px solid var(--borde);
    text-decoration: none;
    color: inherit;
  }
  .det-otro svg {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    color: var(--texto-tenue);
    transition: transform var(--ms-ui) var(--sale);
  }
  .det-otro:hover svg {
    transform: translateX(0.25rem);
  }

  .det-otro-texto {
    display: grid;
    gap: 0.1875rem;
    min-width: 0;
  }

  .det-otro-nombre {
    font-family: 'Sora', sans-serif;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--texto);
    transition: color var(--ms-ui) var(--sale);
  }
  .det-otro:hover .det-otro-nombre {
    color: var(--acento);
  }

  .det-otro-sub {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--texto-tenue);
  }
</style>
