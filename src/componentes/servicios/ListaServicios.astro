---
import { obtenerTextos, obtenerRutas, type Idioma } from '../../helpers/idiomas';
import { servicios, textosServicios, obtenerRutaServicio } from '../../datos/servicios';

interface Props { idioma: Idioma; }

const { idioma } = Astro.props;
const t = obtenerTextos(idioma);
const rutas = obtenerRutas(idioma);
const txt = textosServicios;

const imagenes: Record<string, string> = {
  traduccion: '/imagenes/servicios/traduccion',
  interpretacion: '/imagenes/servicios/interpretacion',
  subtitulado: '/imagenes/servicios/subtitulado',
  textos: '/imagenes/servicios/textos',
  equipamiento: '/imagenes/servicios/equipamiento',
};

const total = String(servicios.length).padStart(2, '0');
---

<section class="srv" id="servicios-showcase">
  <!-- Cabecera editorial -->
  <header class="srv-cabecera">
    <div class="contenedor">
      <p class="antetitulo">{txt.badge[idioma]}</p>
      <h1 class="srv-titulo">{txt.titulo[idioma]}</h1>
    </div>
  </header>

  <!-- Un servicio por bloque, alternando el lado de la fotografia -->
  <div class="contenedor">
    {servicios.map((srv, i) => (
      <article class="srv-bloque" id={`srv-${i}`} data-revelar>
        <div class="srv-foto">
          <picture>
            <source srcset={`${imagenes[srv.id]}.webp`} type="image/webp" />
            <img
              src={`${imagenes[srv.id]}.jpg`}
              alt={srv.titulo[idioma]}
              width="1400"
              height="933"
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </picture>
        </div>

        <div class="srv-cuerpo">
          <p class="srv-indice">
            <span class="cifra">{String(i + 1).padStart(2, '0')}</span>
            <span class="srv-indice-barra"></span>
            <span class="cifra srv-indice-total">{total}</span>
          </p>

          <h2 class="srv-nombre">{srv.titulo[idioma]}</h2>
          <p class="srv-sub">{srv.subtitulo[idioma]}</p>
          <p class="srv-desc">{srv.descripcion[idioma]}</p>

          <div class="srv-esp">
            <p class="srv-esp-titulo">{txt.especialidades[idioma]}</p>
            <ul class="srv-esp-lista">
              {srv.especialidades[idioma].map((esp: string) => (
                <li>{esp}</li>
              ))}
            </ul>
          </div>

          <div class="srv-acciones">
            <a href={obtenerRutaServicio(srv, idioma)} class="boton-principal">
              {txt.verDetalle[idioma]}
            </a>
            <a href={rutas.contacto} class="srv-enlace">
              {txt.cotizar[idioma]}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>

  <!-- Cierre -->
  <div class="srv-cierre">
    <div class="contenedor srv-cierre-fila">
      <div>
        <h3 class="srv-cierre-titulo">{txt.ctaTitulo[idioma]}</h3>
        <p class="srv-cierre-desc">{txt.ctaDesc[idioma]}</p>
      </div>
      <div class="srv-cierre-acciones">
        <a href={rutas.contacto} class="boton-principal">{txt.ctaBoton[idioma]}</a>
        <a href="https://wa.me/51998152086" target="_blank" rel="noopener noreferrer" class="boton-secundario">
          WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* ============================================================
     CABECERA
     ============================================================ */
  .srv-cabecera {
    padding-block: clamp(3rem, 2rem + 4vw, 5.5rem) clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .srv-titulo {
    margin-top: 1.25rem;
    font-family: 'Sora', sans-serif;
    font-size: clamp(2.25rem, 1.7rem + 2.4vw, 3.75rem);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.035em;
    color: var(--navy);
    max-width: 18ch;
  }
  :global(.dark) .srv-titulo {
    color: var(--texto);
  }

  /* ============================================================
     BLOQUE DE SERVICIO
     ============================================================ */
  .srv-bloque {
    display: grid;
    gap: 2rem;
    padding-block: clamp(3rem, 2.5rem + 3vw, 5.5rem);
    border-top: 1px solid var(--borde);
  }

  @media (min-width: 900px) {
    .srv-bloque {
      grid-template-columns: 1fr 1fr;
      gap: 4.5rem;
      align-items: center;
    }

    /* Alterna el lado: rompe el ritmo de lista y obliga a mirar */
    .srv-bloque:nth-child(even) .srv-foto {
      order: 2;
    }
  }

  .srv-foto {
    overflow: hidden;
    border-radius: var(--radio-grande);
    background-color: var(--fondo-hundido);
    aspect-ratio: 3 / 2;
  }
  .srv-foto picture,
  .srv-foto img {
    display: block;
    width: 100%;
    height: 100%;
  }
  .srv-foto img {
    object-fit: cover;
    transition: transform 900ms var(--sale);
  }
  .srv-bloque:hover .srv-foto img {
    transform: scale(1.02);
  }

  /* --- Indice --- */
  .srv-indice {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: 'Sora', sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--texto-tenue);
  }
  .srv-indice-barra {
    width: 2rem;
    height: 1px;
    background-color: var(--ambar);
  }
  .srv-indice-total {
    opacity: 0.55;
  }

  /* --- Texto --- */
  .srv-nombre {
    margin-top: 1.25rem;
    font-family: 'Sora', sans-serif;
    font-size: clamp(1.625rem, 1.35rem + 1.2vw, 2.375rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--navy);
    text-wrap: balance;
  }
  :global(.dark) .srv-nombre {
    color: var(--texto);
  }

  .srv-sub {
    margin-top: 0.75rem;
    font-family: 'Sora', sans-serif;
    font-size: var(--t-guia);
    font-weight: 500;
    color: var(--acento);
  }

  .srv-desc {
    margin-top: 1.25rem;
    max-width: 52ch;
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--texto-medio);
  }

  /* --- Especialidades: lista con filetes, no burbujas --- */
  .srv-esp {
    margin-top: 2rem;
  }

  .srv-esp-titulo {
    font-family: 'Sora', sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--texto-tenue);
  }

  .srv-esp-lista {
    margin-top: 0.875rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    list-style: none;
  }

  .srv-esp-lista li {
    padding-block: 0.5rem;
    padding-right: 1rem;
    border-top: 1px solid var(--borde);
    font-size: 0.875rem;
    color: var(--texto-medio);
  }

  /* --- Acciones --- */
  .srv-acciones {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }

  .srv-enlace {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Sora', sans-serif;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--texto-medio);
    text-decoration: none;
    transition: color var(--ms-ui) var(--sale);
  }
  .srv-enlace svg {
    width: 1rem;
    height: 1rem;
    transition: transform var(--ms-ui) var(--sale);
  }
  .srv-enlace:hover {
    color: var(--texto);
  }
  .srv-enlace:hover svg {
    transform: translateX(0.25rem);
  }

  /* ============================================================
     CIERRE
     ============================================================ */
  .srv-cierre {
    border-top: 1px solid var(--borde);
    background-color: var(--fondo-hundido);
  }

  .srv-cierre-fila {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2rem;
    padding-block: clamp(3rem, 2.5rem + 3vw, 5rem);
  }

  @media (min-width: 800px) {
    .srv-cierre-fila {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 3rem;
    }
  }

  .srv-cierre-titulo {
    font-family: 'Sora', sans-serif;
    font-size: clamp(1.375rem, 1.2rem + 0.8vw, 1.875rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.15;
    color: var(--navy);
    max-width: 22ch;
  }
  :global(.dark) .srv-cierre-titulo {
    color: var(--texto);
  }

  .srv-cierre-desc {
    margin-top: 0.75rem;
    max-width: 46ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--texto-medio);
  }

  .srv-cierre-acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    flex-shrink: 0;
  }
</style>
