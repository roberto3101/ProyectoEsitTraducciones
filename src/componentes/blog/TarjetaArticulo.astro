---
interface Props {
  titulo: string;
  resumen: string;
  imagen?: string;
  fecha: string;
  categoria?: string;
  enlace: string;
  textoLeerMas: string;
  /** 'principal' abre la pagina; 'fila' es el resto del listado */
  variante?: 'principal' | 'fila';
  indice?: number;
}

const {
  titulo,
  resumen,
  imagen,
  fecha,
  categoria,
  enlace,
  textoLeerMas,
  variante = 'fila',
  indice = 0,
} = Astro.props;

// Estimacion de lectura: 200 palabras por minuto sobre el resumen disponible
const minutos = Math.max(2, Math.round((resumen?.split(/\s+/).length ?? 0) / 40));
---

{variante === 'principal' ? (
  <article class="art-principal" data-revelar>
    <a href={enlace} class="art-principal-enlace">
      <div class="art-principal-foto">
        {imagen ? (
          <img src={imagen} alt="" width="1200" height="800" loading="eager" decoding="async" />
        ) : (
          <div class="art-sin-foto"></div>
        )}
      </div>

      <div class="art-principal-cuerpo">
        <div class="art-meta">
          {categoria && <span class="art-categoria">{categoria}</span>}
          <time>{fecha}</time>
          <span class="art-punto">·</span>
          <span>{minutos} min</span>
        </div>

        <h2 class="art-principal-titulo">{titulo}</h2>
        <p class="art-principal-resumen">{resumen}</p>

        <span class="art-leer">
          {textoLeerMas}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </div>
    </a>
  </article>
) : (
  <article class="art-fila" data-revelar style={`--rev-i: ${indice}`}>
    <a href={enlace} class="art-fila-enlace">
      <div class="art-fila-texto">
        <div class="art-meta">
          {categoria && <span class="art-categoria">{categoria}</span>}
          <time>{fecha}</time>
          <span class="art-punto">·</span>
          <span>{minutos} min</span>
        </div>

        <h3 class="art-fila-titulo">{titulo}</h3>
        <p class="art-fila-resumen">{resumen}</p>
      </div>

      <div class="art-fila-foto">
        {imagen ? (
          <img src={imagen} alt="" width="480" height="320" loading="lazy" decoding="async" />
        ) : (
          <div class="art-sin-foto"></div>
        )}
      </div>
    </a>
  </article>
)}

<style>
  /* ============================================================
     COMUN
     ============================================================ */
  .art-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.75rem;
    color: var(--texto-tenue);
    font-variant-numeric: tabular-nums;
  }

  .art-categoria {
    font-family: 'Sora', sans-serif;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 0.6875rem;
    color: var(--acento);
  }

  .art-punto {
    opacity: 0.5;
  }

  .art-sin-foto {
    width: 100%;
    height: 100%;
    background-color: var(--fondo-hundido);
    border: 1px solid var(--borde);
  }

  .art-leer {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Sora', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--acento);
  }
  .art-leer svg {
    width: 1rem;
    height: 1rem;
    transition: transform var(--ms-ui) var(--sale);
  }

  /* ============================================================
     ARTICULO PRINCIPAL
     ============================================================ */
  .art-principal-enlace {
    display: grid;
    gap: 2rem;
    text-decoration: none;
    color: inherit;
  }

  @media (min-width: 900px) {
    .art-principal-enlace {
      grid-template-columns: 1.15fr 1fr;
      gap: 3.5rem;
      align-items: center;
    }
  }

  .art-principal-foto {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: var(--radio-grande);
    background-color: var(--fondo-hundido);
  }
  .art-principal-foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--sale);
  }
  .art-principal-enlace:hover .art-principal-foto img {
    transform: scale(1.03);
  }

  .art-principal-titulo {
    margin-top: 1.25rem;
    font-family: 'Sora', sans-serif;
    font-size: clamp(1.75rem, 1.3rem + 1.8vw, 2.75rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.032em;
    color: var(--navy);
    text-wrap: balance;
  }
  :global(.dark) .art-principal-titulo {
    color: var(--texto);
  }

  .art-principal-resumen {
    margin-top: 1.125rem;
    font-size: var(--t-guia);
    line-height: 1.6;
    color: var(--texto-medio);
    max-width: 48ch;
  }

  .art-principal-cuerpo .art-leer {
    margin-top: 1.75rem;
  }
  .art-principal-enlace:hover .art-leer svg {
    transform: translateX(0.25rem);
  }

  /* ============================================================
     FILAS
     ============================================================ */
  .art-fila {
    border-top: 1px solid var(--borde);
  }

  .art-fila-enlace {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    padding-block: 2rem;
    text-decoration: none;
    color: inherit;
  }

  @media (min-width: 700px) {
    .art-fila-enlace {
      grid-template-columns: 1fr 13rem;
      gap: 2.5rem;
      align-items: start;
      padding-block: 2.5rem;
    }
  }

  .art-fila-titulo {
    margin-top: 0.875rem;
    font-family: 'Sora', sans-serif;
    font-size: clamp(1.1875rem, 1.1rem + 0.4vw, 1.5rem);
    font-weight: 600;
    line-height: 1.22;
    letter-spacing: -0.022em;
    color: var(--navy);
    text-wrap: balance;
    transition: color var(--ms-ui) var(--sale);
  }
  :global(.dark) .art-fila-titulo {
    color: var(--texto);
  }
  .art-fila-enlace:hover .art-fila-titulo {
    color: var(--acento);
  }

  .art-fila-resumen {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--texto-medio);
    max-width: 62ch;
    /* Dos lineas: mantiene el ritmo vertical del listado */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .art-fila-foto {
    order: -1;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: var(--radio);
    background-color: var(--fondo-hundido);
  }

  @media (min-width: 700px) {
    .art-fila-foto {
      order: 0;
    }
  }

  .art-fila-foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--sale);
  }
  .art-fila-enlace:hover .art-fila-foto img {
    transform: scale(1.04);
  }
</style>
