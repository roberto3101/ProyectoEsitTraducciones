---
import TarjetaArticulo from './TarjetaArticulo.astro';
import { obtenerTextos, type Idioma } from '../../helpers/idiomas';
import { formatearFecha, imagenEntrega } from '../../helpers/sanity';

interface Props {
  idioma: Idioma;
  articulos?: any[];
  pagina?: number;
  totalPaginas?: number;
  categoriaActual?: string;
}
const { idioma, articulos = [], pagina = 1, totalPaginas = 1, categoriaActual = '' } = Astro.props;
const t = obtenerTextos(idioma);

const txtPag: Record<string, Record<string, string>> = {
  es: { anterior: 'Anterior', siguiente: 'Siguiente', pagina: 'Página' },
  en: { anterior: 'Previous', siguiente: 'Next', pagina: 'Page' },
  fr: { anterior: 'Précédent', siguiente: 'Suivant', pagina: 'Page' },
};
const tp = txtPag[idioma] || txtPag.es;

// Construir URL de paginación manteniendo filtro de categoría
function urlPagina(num: number): string {
  const params = new URLSearchParams();
  if (categoriaActual) params.set('cat', categoriaActual);
  if (num > 1) params.set('page', String(num));
  const qs = params.toString();
  return `/${idioma}/blog${qs ? '?' + qs : ''}`;
}

// Rango de páginas visibles (máx 5 botones)
function rangoVisble(): number[] {
  const rango: number[] = [];
  let inicio = Math.max(1, pagina - 2);
  let fin = Math.min(totalPaginas, inicio + 4);
  inicio = Math.max(1, fin - 4);
  for (let i = inicio; i <= fin; i++) rango.push(i);
  return rango;
}
const paginasVisibles = rangoVisble();

// El articulo principal solo encabeza la primera pagina sin filtrar:
// en una vista filtrada o paginada jerarquizar el primero seria arbitrario.
const abrePortada = pagina === 1 && !categoriaActual && articulos.length > 0;
const destacado = abrePortada ? articulos[0] : null;
const resto = abrePortada ? articulos.slice(1) : articulos;
---

<section class="blog-lista">
  <div class="contenedor">
    {articulos.length > 0 ? (
      <>
        {destacado && (
          <div class="blog-portada">
            <TarjetaArticulo
              titulo={destacado.titulo}
              resumen={destacado.resumen}
              imagen={imagenEntrega(destacado.imagen, { ancho: 900, alto: 600, recortar: true })}
              fecha={formatearFecha(destacado.fecha, idioma)}
              categoria={destacado.categoria}
              enlace={'/' + idioma + '/blog/' + destacado.slug}
              textoLeerMas={t.blog.leerMas}
              variante="principal"
            />
          </div>
        )}

        {resto.length > 0 && (
          <div class="blog-filas">
            {resto.map((art, i) => (
              <TarjetaArticulo
                titulo={art.titulo}
                resumen={art.resumen}
                imagen={imagenEntrega(art.imagen, { ancho: 480, alto: 320, recortar: true })}
                fecha={formatearFecha(art.fecha, idioma)}
                categoria={art.categoria}
                enlace={'/' + idioma + '/blog/' + art.slug}
                textoLeerMas={t.blog.leerMas}
                variante="fila"
                indice={i}
              />
            ))}
          </div>
        )}

        {totalPaginas > 1 && (
          <nav class="pag" aria-label={tp.pagina}>
            {pagina > 1 ? (
              <a href={urlPagina(pagina - 1)} class="pag-salto" rel="prev">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M19 12H5M11 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="pag-etiqueta">{tp.anterior}</span>
              </a>
            ) : (
              <span class="pag-salto" aria-disabled="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M19 12H5M11 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="pag-etiqueta">{tp.anterior}</span>
              </span>
            )}

            <div class="pag-numeros">
              {paginasVisibles[0] > 1 && (
                <>
                  <a href={urlPagina(1)} class="pag-num">1</a>
                  {paginasVisibles[0] > 2 && <span class="pag-elipsis">…</span>}
                </>
              )}

              {paginasVisibles.map((num) =>
                num === pagina ? (
                  <span class="pag-num pag-num-activa" aria-current="page">{num}</span>
                ) : (
                  <a href={urlPagina(num)} class="pag-num">{num}</a>
                ),
              )}

              {paginasVisibles[paginasVisibles.length - 1] < totalPaginas && (
                <>
                  {paginasVisibles[paginasVisibles.length - 1] < totalPaginas - 1 && (
                    <span class="pag-elipsis">…</span>
                  )}
                  <a href={urlPagina(totalPaginas)} class="pag-num">{totalPaginas}</a>
                </>
              )}
            </div>

            {pagina < totalPaginas ? (
              <a href={urlPagina(pagina + 1)} class="pag-salto" rel="next">
                <span class="pag-etiqueta">{tp.siguiente}</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            ) : (
              <span class="pag-salto" aria-disabled="true">
                <span class="pag-etiqueta">{tp.siguiente}</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            )}
          </nav>
        )}
      </>
    ) : (
      <div class="blog-vacio">
        <p class="blog-vacio-titulo">{t.blog.sinArticulos}</p>
        <a href={`/${idioma}/blog`} class="boton-secundario">{tp.pagina} 1</a>
      </div>
    )}
  </div>
</section>

<style>
  .blog-lista {
    padding-block: clamp(2rem, 1.5rem + 2vw, 3.5rem) clamp(4rem, 3rem + 5vw, 8rem);
  }

  .blog-portada {
    padding-bottom: clamp(3rem, 2.5rem + 2vw, 4.5rem);
  }

  /* El filete superior de la primera fila cierra el bloque de portada */
  .blog-filas {
    border-bottom: 1px solid var(--borde);
  }

  /* ============================================================
     PAGINACION
     ============================================================ */
  .pag {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3.5rem;
  }

  .pag-salto {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.625rem 1rem;
    border-radius: var(--radio);
    border: 1px solid var(--borde);
    font-family: 'Sora', sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--texto-medio);
    text-decoration: none;
    transition:
      border-color var(--ms-ui) var(--sale),
      color var(--ms-ui) var(--sale);
  }
  .pag-salto svg {
    width: 1rem;
    height: 1rem;
  }
  a.pag-salto:hover {
    border-color: var(--borde-marcado);
    color: var(--texto);
  }
  .pag-salto[aria-disabled='true'] {
    opacity: 0.4;
    cursor: not-allowed;
  }

  @media (max-width: 520px) {
    .pag-etiqueta {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
  }

  .pag-numeros {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .pag-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radio);
    font-family: 'Sora', sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--texto-medio);
    text-decoration: none;
    transition:
      background-color var(--ms-rapido) var(--sale),
      color var(--ms-rapido) var(--sale);
  }
  a.pag-num:hover {
    background-color: var(--fondo-hundido);
    color: var(--texto);
  }

  .pag-num-activa {
    background-color: var(--navy);
    color: #fff;
  }
  :global(.dark) .pag-num-activa {
    background-color: var(--acento);
    color: var(--navy-hondo);
  }

  .pag-elipsis {
    padding-inline: 0.25rem;
    color: var(--texto-tenue);
  }

  /* ============================================================
     VACIO
     ============================================================ */
  .blog-vacio {
    padding-block: clamp(4rem, 3rem + 5vw, 7rem);
    border-top: 1px solid var(--borde);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .blog-vacio-titulo {
    font-family: 'Sora', sans-serif;
    font-size: var(--t-guia);
    color: var(--texto-medio);
  }
</style>
