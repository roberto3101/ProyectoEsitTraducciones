---
import Pregunta from './Pregunta.astro';
import { obtenerTextos, obtenerRutas, type Idioma } from '../../helpers/idiomas';

interface Props { idioma: Idioma; }
const { idioma } = Astro.props;
const t = obtenerTextos(idioma);
const rutas = obtenerRutas(idioma);

const ayuda: Record<string, { titulo: string; texto: string; boton: string }> = {
  es: {
    titulo: '¿No encuentra su respuesta?',
    texto: 'Escríbanos y le respondemos el mismo día hábil.',
    boton: 'Hablar con el equipo',
  },
  en: {
    titulo: "Can't find your answer?",
    texto: 'Write to us and we reply within the same business day.',
    boton: 'Talk to the team',
  },
  fr: {
    titulo: 'Vous ne trouvez pas votre réponse ?',
    texto: 'Écrivez-nous et nous répondons le jour ouvrable même.',
    boton: "Parler à l'équipe",
  },
};
const a = ayuda[idioma] || ayuda.es;
---

<section class="faqs">
  <div class="contenedor faqs-rejilla">
    <!-- Titulo fijo a un lado mientras la lista se recorre al otro -->
    <header class="faqs-cabecera" data-revelar>
      <h1 class="faqs-titulo">{t.preguntas.titulo}</h1>
      <p class="faqs-bajada">{t.preguntas.subtitulo}</p>

      <div class="faqs-ayuda">
        <p class="faqs-ayuda-titulo">{a.titulo}</p>
        <p class="faqs-ayuda-texto">{a.texto}</p>
        <a href={rutas.contacto} class="boton-secundario faqs-ayuda-boton">{a.boton}</a>
      </div>
    </header>

    <div class="faqs-lista" data-revelar>
      {t.preguntas.items.map((item) => (
        <Pregunta pregunta={item.pregunta} respuesta={item.respuesta} />
      ))}
    </div>
  </div>
</section>

<style>
  .faqs {
    padding-block: clamp(3rem, 2rem + 4vw, 5.5rem) clamp(3.5rem, 3rem + 3vw, 6rem);
  }

  .faqs-rejilla {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 950px) {
    .faqs-rejilla {
      grid-template-columns: 22rem 1fr;
      gap: 5rem;
      align-items: start;
    }

    .faqs-cabecera {
      position: sticky;
      top: 7rem;
    }
  }

  .faqs-titulo {
    font-family: 'Sora', sans-serif;
    font-size: clamp(2rem, 1.6rem + 1.9vw, 3.25rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: var(--navy);
    text-wrap: balance;
  }
  :global(.dark) .faqs-titulo {
    color: var(--texto);
  }

  .faqs-bajada {
    margin-top: 1.125rem;
    max-width: 40ch;
    font-size: var(--t-guia);
    line-height: 1.6;
    color: var(--texto-medio);
  }

  .faqs-ayuda {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--borde);
  }

  .faqs-ayuda-titulo {
    font-family: 'Sora', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    color: var(--texto);
  }

  .faqs-ayuda-texto {
    margin-top: 0.5rem;
    max-width: 34ch;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--texto-medio);
  }

  .faqs-ayuda-boton {
    margin-top: 1.25rem;
  }

  /* Cierra la lista por abajo, igual que la abre el primer filete */
  .faqs-lista {
    border-bottom: 1px solid var(--borde);
  }
</style>
