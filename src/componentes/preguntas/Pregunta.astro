---
interface Props { pregunta: string; respuesta: string; }
const { pregunta, respuesta } = Astro.props;
---

<details class="faq">
  <summary class="faq-pregunta">
    <span>{pregunta}</span>
    <span class="faq-signo" aria-hidden="true"></span>
  </summary>
  <div class="faq-respuesta">
    <p>{respuesta}</p>
  </div>
</details>

<style>
  /* Separadas por filete, sin caja: leen como indice, no como tarjetas */
  .faq {
    border-top: 1px solid var(--borde);
  }

  .faq-pregunta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 1.375rem;
    cursor: pointer;
    list-style: none;
    font-family: 'Sora', sans-serif;
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.015em;
    color: var(--texto);
    transition: color var(--ms-ui) var(--sale);
  }
  .faq-pregunta::-webkit-details-marker {
    display: none;
  }
  .faq-pregunta:hover {
    color: var(--acento);
  }

  /* Signo mas que se convierte en menos: dos trazos, sin icono externo */
  .faq-signo {
    position: relative;
    flex-shrink: 0;
    width: 0.875rem;
    height: 0.875rem;
  }
  .faq-signo::before,
  .faq-signo::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    height: 1.5px;
    background-color: currentColor;
    transition: transform var(--ms-ui) var(--sale);
  }
  .faq-signo::after {
    transform: rotate(90deg);
  }
  .faq[open] .faq-signo::after {
    transform: rotate(0deg);
  }

  .faq-respuesta {
    padding-bottom: 1.5rem;
    padding-right: 3rem;
  }

  .faq-respuesta p {
    max-width: 68ch;
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--texto-medio);
  }

  /* La respuesta entra desplegandose, no apareciendo de golpe */
  .faq[open] .faq-respuesta {
    animation: faqAbrir 320ms var(--sale);
  }

  @keyframes faqAbrir {
    from {
      opacity: 0;
      transform: translateY(-0.375rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq[open] .faq-respuesta {
      animation: none;
    }
  }
</style>
