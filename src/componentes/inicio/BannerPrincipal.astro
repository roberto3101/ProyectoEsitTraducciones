---
import { obtenerTextos, obtenerRutas, type Idioma } from '../../helpers/idiomas';

interface Props { idioma: Idioma; }

const { idioma } = Astro.props as { idioma: 'es' | 'en' | 'fr' };
const t = obtenerTextos(idioma);
const rutas = obtenerRutas(idioma);

const cifras: Record<string, { valor: string; label: string }[]> = {
  es: [
    { valor: '33', label: 'Años traduciendo' },
    { valor: '3', label: 'Idiomas de trabajo' },
    { valor: '500+', label: 'Proyectos entregados' },
    { valor: '100%', label: 'Confidencialidad' },
  ],
  en: [
    { valor: '33', label: 'Years translating' },
    { valor: '3', label: 'Working languages' },
    { valor: '500+', label: 'Projects delivered' },
    { valor: '100%', label: 'Confidentiality' },
  ],
  fr: [
    { valor: '33', label: 'Ans de traduction' },
    { valor: '3', label: 'Langues de travail' },
    { valor: '500+', label: 'Projets livrés' },
    { valor: '100%', label: 'Confidentialité' },
  ],
};

const antetitulo: Record<string, string> = {
  es: 'Lima, Perú — desde 1992',
  en: 'Lima, Peru — since 1992',
  fr: 'Lima, Pérou — depuis 1992',
};

const pieFoto: Record<string, string> = {
  es: 'Cabina de interpretación simultánea',
  en: 'Simultaneous interpretation booth',
  fr: "Cabine d'interprétation simultanée",
};

// El titular se parte en palabras para que entren escalonadas tras una mascara
const palabras = t.hero.titulo.split(' ');
---

<section class="hero" data-progreso>
  <!-- Fotografia: se desplaza mas lento que el texto -->
  <div class="hero-foto" data-parallax="0.16">
    <picture>
      <source srcset="/imagenes/hero/cabina.webp" type="image/webp" />
      <img
        src="/imagenes/hero/cabina.jpg"
        alt={pieFoto[idioma]}
        width="2400"
        height="1029"
        loading="eager"
        decoding="sync"
        fetchpriority="high"
      />
    </picture>
  </div>

  <!-- Velo: no es decoracion, es lo que hace legible el texto sobre la foto -->
  <div class="hero-velo"></div>

  <!-- Meridianos: se dibujan al cargar y derivan con el scroll -->
  <svg class="hero-meridianos" viewBox="0 0 1200 620" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <path d="M-40 210 C 240 120, 560 120, 840 210 S 1140 300, 1240 260" />
    <path d="M-40 330 C 260 230, 600 230, 900 330 S 1160 420, 1240 380" />
    <path d="M-40 450 C 280 350, 640 350, 960 450 S 1180 540, 1240 500" />
  </svg>

  <div class="hero-cuerpo contenedor">
    <p class="antetitulo hero-entra" style="--rev-i: 0">{antetitulo[idioma]}</p>

    <h1 class="hero-titular">
      {palabras.map((palabra, i) => (
        <span class="hero-mascara"><span class="hero-palabra" style={`--rev-i: ${i}`}>{palabra}</span></span>
      ))}
    </h1>

    <p class="hero-bajada hero-entra" style={`--rev-i: ${palabras.length + 1}`}>
      {t.hero.subtitulo}
    </p>

    <div class="hero-acciones hero-entra" style={`--rev-i: ${palabras.length + 2}`}>
      <a href={rutas.contacto} class="boton-principal hero-cta">
        {t.hero.botonContacto}
      </a>
      <a href={rutas.servicios} class="hero-enlace">
        {t.hero.botonServicios}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </div>

  <!-- Cifras: separadas por filete, no por caja -->
  <div class="hero-cifras">
    <div class="contenedor hero-cifras-rejilla">
      {cifras[idioma].map((c, i) => (
        <div class="hero-cifra hero-entra" style={`--rev-i: ${palabras.length + 3 + i}`}>
          <span class="cifra hero-cifra-valor">{c.valor}</span>
          <span class="hero-cifra-label">{c.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: min(92svh, 54rem);
    /* La barra transparente se superpone: el contenido arranca por debajo */
    padding-top: 8rem;
    background-color: var(--navy-hondo);
    overflow: clip;
  }

  /* --- Fotografia --- */
  .hero-foto {
    position: absolute;
    inset: -8% 0 -8% 0;
    z-index: 0;
    transform: translate3d(0, var(--desplazo, 0), 0);
    will-change: transform;
  }

  .hero-foto picture,
  .hero-foto img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-foto img {
    object-fit: cover;
    object-position: 68% center;
  }

  /* Velo funcional: oscurece el lado del texto y asienta el pie */
  .hero-velo {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(to right, rgb(4 8 16 / 0.92) 0%, rgb(4 8 16 / 0.72) 38%, rgb(4 8 16 / 0.15) 72%),
      linear-gradient(to top, rgb(4 8 16 / 0.85) 0%, transparent 45%);
  }

  /* --- Meridianos --- */
  .hero-meridianos {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    pointer-events: none;
    /* Derivan hacia arriba conforme avanza el scroll */
    transform: translate3d(0, calc(var(--vista, 0) * -6rem), 0);
  }

  .hero-meridianos path {
    fill: none;
    stroke: var(--ambar);
    stroke-width: 1;
    opacity: 0.22;
    stroke-dasharray: 2000;
    stroke-dashoffset: 2000;
    animation: trazar 2.4s var(--sale) forwards;
  }
  .hero-meridianos path:nth-child(2) { animation-delay: 0.18s; opacity: 0.14; }
  .hero-meridianos path:nth-child(3) { animation-delay: 0.36s; opacity: 0.09; }

  @keyframes trazar {
    to { stroke-dashoffset: 0; }
  }

  /* --- Contenido --- */
  .hero-cuerpo {
    position: relative;
    z-index: 3;
    padding-block: clamp(3rem, 6vw, 6rem);
    max-width: 80rem;
  }

  .hero-cuerpo .antetitulo {
    color: rgb(255 255 255 / 0.62);
  }

  .hero-titular {
    margin-top: 1.75rem;
    font-size: var(--t-display);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: #fff;
    max-width: 16ch;
    text-wrap: balance;
  }

  /* Cada palabra sube desde detras de su propia mascara */
  .hero-mascara {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    padding-right: 0.22em;
  }

  .hero-palabra {
    display: inline-block;
    transform: translateY(105%);
    animation: subir 0.9s var(--sale) forwards;
    animation-delay: calc(var(--rev-i, 0) * 70ms + 120ms);
  }

  @keyframes subir {
    to { transform: translateY(0); }
  }

  .hero-bajada {
    margin-top: 1.75rem;
    max-width: 44ch;
    font-size: var(--t-guia);
    line-height: 1.6;
    color: rgb(255 255 255 / 0.74);
  }

  .hero-acciones {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem 2rem;
  }

  .hero-cta {
    background-color: var(--papel);
    color: var(--navy);
    padding: 0.9375rem 1.75rem;
  }
  .hero-cta:hover {
    background-color: #fff;
  }

  .hero-enlace {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-family: 'Sora', sans-serif;
    font-size: 0.9375rem;
    font-weight: 500;
    color: rgb(255 255 255 / 0.82);
    text-decoration: none;
  }
  .hero-enlace svg {
    width: 1.125rem;
    height: 1.125rem;
    transition: transform var(--ms-ui) var(--sale);
  }
  .hero-enlace:hover {
    color: #fff;
  }
  .hero-enlace:hover svg {
    transform: translateX(0.25rem);
  }

  /* --- Cifras --- */
  .hero-cifras {
    position: relative;
    z-index: 3;
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }

  .hero-cifras-rejilla {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  @media (min-width: 768px) {
    .hero-cifras-rejilla {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .hero-cifra {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1.5rem 0.5rem 1.5rem 0;
  }

  /* Filetes entre columnas, sin cerrar cajas */
  .hero-cifra + .hero-cifra {
    border-left: 1px solid rgb(255 255 255 / 0.12);
    padding-left: 1.5rem;
  }
  @media (max-width: 767px) {
    .hero-cifra:nth-child(3) {
      border-left: 0;
      padding-left: 0;
    }
    .hero-cifra:nth-child(-n + 2) {
      border-bottom: 1px solid rgb(255 255 255 / 0.12);
    }
  }

  .hero-cifra-valor {
    font-family: 'Sora', sans-serif;
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem);
    font-weight: 600;
    line-height: 1;
    color: #fff;
  }

  .hero-cifra-label {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: rgb(255 255 255 / 0.55);
  }

  /* --- Entrada escalonada del resto de piezas --- */
  .hero-entra {
    opacity: 0;
    transform: translateY(1.25rem);
    animation: asomar 0.85s var(--sale) forwards;
    animation-delay: calc(var(--rev-i, 0) * 70ms + 260ms);
  }

  @keyframes asomar {
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-palabra,
    .hero-entra {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .hero-meridianos path {
      animation: none;
      stroke-dashoffset: 0;
    }
    .hero-foto {
      transform: none;
    }
  }
</style>
