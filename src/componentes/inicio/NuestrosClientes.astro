---
const { idioma = 'es' } = Astro.props as { idioma: 'es' | 'en' | 'fr' };

const clientes = [
  { nombre: "USAID", logo: "/imagenes/clientes/usaid.svg", url: "https://www.usaid.gov", color: "#002F6C", accent: "#BA0C2F" },
  { nombre: "United Nations", logo: "/imagenes/clientes/onu.png", url: "https://www.un.org", color: "#4B92DB", accent: "#4B92DB" },
  { nombre: "CARE", logo: "/imagenes/clientes/care.svg", url: "https://www.care.org", color: "#F26522", accent: "#F26522" },
  { nombre: "IFC", logo: "/imagenes/clientes/ifc.svg", url: "https://www.ifc.org", color: "#009CDE", accent: "#00355F" },
  { nombre: "IDB", logo: "/imagenes/clientes/bid.svg", url: "https://www.iadb.org", color: "#003876", accent: "#00A9E0" },
  { nombre: "Ipsos", logo: "/imagenes/clientes/ipsos.svg", url: "https://www.ipsos.com", color: "#006837", accent: "#006837" },
  { nombre: "Moody's", logo: "/imagenes/clientes/moodys.png", url: "https://www.moodys.com", color: "#1A237E", accent: "#1A237E" },
  { nombre: "McKinsey", logo: "/imagenes/clientes/mckinsey.svg", url: "https://www.mckinsey.com", color: "#003A70", accent: "#003A70" },
  { nombre: "3M", logo: "/imagenes/clientes/3m.svg", url: "https://www.3m.com", color: "#FF0000", accent: "#FF0000" },
];

const titulo: Record<string, string> = {
  es: "Confíe en nosotros como lo hacen nuestros clientes",
  en: "Trust us as our clients do",
  fr: "Faites-nous confiance comme nos clients"
};
const subtitulo: Record<string, string> = {
  es: "Atendemos todos sus proyectos, pequeños, grandes, a nivel local o global.",
  en: "We handle all your projects, small, large, local or global.",
  fr: "Nous gérons tous vos projets, petits, grands, au niveau local ou mondial."
};
---

<section class="py-16 md:py-24 bg-white dark:bg-oscuro-fondo border-t border-b border-gray-100 dark:border-oscuro-borde">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-14">
      <h2 class="text-2xl sm:text-3xl font-bold text-marca-azul dark:text-white mb-3" style="font-family: 'Sora', sans-serif;">
        {titulo[idioma]}
      </h2>
      <p class="text-sm sm:text-base text-marca-gris dark:text-oscuro-texto max-w-xl mx-auto">
        {subtitulo[idioma]}
      </p>
    </div>

    {/* Carrusel infinito */}
    <div class="clientes-carrusel">
      <div class="clientes-track">
        {/* Triplicamos para scroll infinito sin cortes */}
        {[...clientes, ...clientes, ...clientes].map((cliente, i) => (
          <a href={cliente.url} target="_blank" rel="noopener noreferrer nofollow"
            class="cliente-item" title={cliente.nombre}>
            <img src={cliente.logo} alt={cliente.nombre}
              class="max-h-10 sm:max-h-12 max-w-[140px] object-contain" loading="lazy"
              width="140" height="48" />
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .clientes-carrusel {
    position: relative;
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
  }

  .clientes-track {
    display: flex;
    gap: 3rem;
    align-items: center;
    width: max-content;
    animation: scroll-logos 22s linear infinite;
  }

  .clientes-track:hover {
    animation-play-state: paused;
  }

  .cliente-item {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 4rem;
    min-width: 120px;
    padding: 0 0.5rem;
  }

  /* Muro de logos monocromo: unifica marcas de colores dispares y, sobre
     todo, evita que los logos azul marino desaparezcan en modo oscuro. */
  .cliente-item img {
    max-height: 100%;
    filter: brightness(0) opacity(0.5);
    transition:
      filter var(--ms-ui) var(--sale),
      transform var(--ms-ui) var(--sale);
  }

  :global(.dark) .cliente-item img {
    filter: brightness(0) invert(1) opacity(0.55);
  }

  .cliente-item:hover img {
    filter: brightness(0) opacity(0.9);
    transform: scale(1.06);
  }

  :global(.dark) .cliente-item:hover img {
    filter: brightness(0) invert(1) opacity(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .clientes-track {
      animation: none;
    }
    .clientes-carrusel {
      overflow-x: auto;
    }
  }

  @keyframes scroll-logos {
    0% { transform: translateX(0); }
    100% { transform: translateX(calc(-100% / 3)); }
  }

  @media (max-width: 640px) {
    .clientes-track {
      gap: 2rem;
      animation-duration: 14s;
    }
    .cliente-item {
      min-width: 90px;
    }
  }
</style>