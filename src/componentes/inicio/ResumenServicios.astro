---
import { obtenerTextos, obtenerRutas, type Idioma } from '../../helpers/idiomas';
import { servicios as datosServicios, obtenerRutaServicio } from '../../datos/servicios';

interface Props { idioma: Idioma; }

const { idioma } = Astro.props;
const t = obtenerTextos(idioma);
const rutas = obtenerRutas(idioma);

const imagenes: Record<string, string> = {
  traduccion: '/imagenes/servicios/traduccion.jpg',
  interpretacion: '/imagenes/servicios/interpretacion.jpg',
  subtitulado: '/imagenes/servicios/subtitulado.jpg',
  textos: '/imagenes/servicios/textos.jpg',
  equipamiento: '/imagenes/servicios/equipamiento.jpg',
};

const textos = {
  es: {
    badge: "Lo que hacemos",
    titulo: "Servicios",
    cotizar: "Solicitar cotización",
    verTodos: "Explorar todos los servicios",
    explorar: "Explorar",
  },
  en: {
    badge: "What we do",
    titulo: "Services",
    cotizar: "Request a quote",
    verTodos: "Explore all services",
    explorar: "Explore",
  },
  fr: {
    badge: "Ce que nous faisons",
    titulo: "Services",
    cotizar: "Demander un devis",
    verTodos: "Explorer tous les services",
    explorar: "Explorer",
  },
};

const txt = textos[idioma] || textos.es;
---

<section class="relative overflow-hidden bg-white dark:bg-oscuro-fondo" id="servicios">
  <div class="max-w-7xl mx-auto px-5 sm:px-6">

    {/* Header con número grande decorativo */}
    <div class="pt-20 md:pt-28 pb-10 md:pb-14 relative" data-revelar>
      <div class="absolute -top-4 right-4 sm:right-8 text-[140px] sm:text-[200px] md:text-[280px] font-black leading-none select-none pointer-events-none opacity-[0.018] dark:opacity-[0.03]"
        style="font-family: 'Sora', sans-serif; letter-spacing: -0.05em;">
        05
      </div>
      <p class="text-xs font-bold tracking-[0.3em] uppercase text-marca-azulBrillante dark:text-blue-400 mb-4">
        {txt.badge}
      </p>
      <h2 class="text-4xl sm:text-5xl md:text-6xl font-black text-marca-azul dark:text-white"
        style="font-family: 'Sora', sans-serif; line-height: 1.05; letter-spacing: -0.03em;">
        {txt.titulo}
      </h2>
    </div>

    {/* Servicio destacado (primero) - layout horizontal */}
    <div class="srv-featured group relative mb-4 rounded-2xl overflow-hidden cursor-pointer"
      data-color={datosServicios[0].color} data-revelar>
      <a href={obtenerRutaServicio(datosServicios[0], idioma)} class="block">
        <div class="grid grid-cols-1 lg:grid-cols-12 min-h-[280px] lg:min-h-[320px]">
          {/* Lado izquierdo - imagen */}
          <div class="lg:col-span-4 relative min-h-[200px] lg:min-h-0">
            <img src="/imagenes/servicios/traduccion.jpg" alt={datosServicios[0].titulo[idioma]}
              class="absolute inset-0 w-full h-full object-cover" width="800" height="600" loading="lazy" />
            <div class="absolute inset-0 opacity-15 mix-blend-multiply"
              style={`background: linear-gradient(160deg, transparent 30%, ${datosServicios[0].color});`}></div>
            <div class="absolute bottom-4 left-4 w-11 h-11 rounded-xl flex items-center justify-center backdrop-blur-md bg-white/80 dark:bg-black/50"
              style={`color: ${datosServicios[0].color};`}>
              <Fragment set:html={datosServicios[0].icono.replace('w-8 h-8', 'w-5 h-5')} />
            </div>
          </div>
          {/* Lado derecho - contenido */}
          <div class="lg:col-span-8 p-8 lg:p-10 flex flex-col justify-center
            border-t lg:border-t-0 lg:border-l border-slate-100 dark:border-oscuro-borde">
            <h3 class="text-2xl sm:text-3xl font-bold text-marca-azul dark:text-white mb-3
              group-hover:text-marca-azulBrillante dark:group-hover:text-blue-300 transition-colors"
              style="font-family: 'Sora', sans-serif; letter-spacing: -0.02em;">
              {datosServicios[0].titulo[idioma]}
            </h3>
            <p class="text-sm sm:text-base text-marca-gris dark:text-slate-400 mb-6 max-w-xl" style="line-height: 1.8;">
              {datosServicios[0].descripcion[idioma]}
            </p>
            <div class="flex flex-wrap gap-2 mb-6">
              {datosServicios[0].especialidades[idioma].slice(0, 5).map((tag: string) => (
                <span class="px-3 py-1 text-[11px] font-semibold rounded-full
                  border border-slate-150 dark:border-oscuro-borde
                  text-slate-500 dark:text-slate-400">
                  {tag}
                </span>
              ))}
            </div>
            <span class="inline-flex items-center gap-2 text-sm font-bold transition-all duration-300
              group-hover:gap-3"
              style={`color: ${datosServicios[0].color};`}>
              {txt.explorar}
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </span>
          </div>
        </div>
      </a>
      {/* Borde animado */}
      <div class="absolute inset-0 rounded-2xl border border-slate-100 dark:border-oscuro-borde
        group-hover:border-transparent transition-colors pointer-events-none"></div>
      <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
        style={`box-shadow: inset 0 0 0 1.5px ${datosServicios[0].color}30;`}></div>
    </div>

    {/* Grid 2x2 para los otros 4 servicios */}
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4" data-revelar-grupo>
      {datosServicios.slice(1).map((srv, i) => (
        <a href={obtenerRutaServicio(srv, idioma)}
          class="srv-card group relative rounded-2xl overflow-hidden
            border border-slate-100 dark:border-oscuro-borde
            hover:border-transparent transition-all duration-500">

          {/* Imagen header */}
          <div class="relative h-36 sm:h-40 overflow-hidden">
            <img src={imagenes[srv.id]} alt={srv.titulo[idioma]}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              width="800" height="600" loading="lazy" />
            <div class="absolute inset-0 opacity-10 mix-blend-multiply"
              style={`background: linear-gradient(160deg, transparent 30%, ${srv.color});`}></div>
            <div class="absolute top-3 right-3 w-9 h-9 rounded-lg flex items-center justify-center backdrop-blur-md bg-white/80 dark:bg-black/50"
              style={`color: ${srv.color};`}>
              <Fragment set:html={srv.icono.replace('w-8 h-8', 'w-4 h-4')} />
            </div>
          </div>

          <div class="p-7 lg:p-8 h-full flex flex-col">

            {/* Contenido */}
            <h3 class="text-lg sm:text-xl font-bold text-marca-azul dark:text-white mb-2.5
              group-hover:text-marca-azulBrillante dark:group-hover:text-blue-300 transition-colors"
              style="font-family: 'Sora', sans-serif; letter-spacing: -0.01em;">
              {srv.titulo[idioma]}
            </h3>
            <p class="text-sm text-marca-gris dark:text-slate-400 leading-relaxed mb-5 flex-1">
              {srv.descripcion[idioma]}
            </p>

            {/* Tags */}
            <div class="flex flex-wrap gap-1.5 mb-5">
              {srv.especialidades[idioma].slice(0, 4).map((tag: string) => (
                <span class="px-2.5 py-0.5 text-[10px] font-semibold rounded-full
                  border border-slate-100 dark:border-oscuro-borde
                  text-slate-400 dark:text-slate-500">
                  {tag}
                </span>
              ))}
            </div>

            {/* CTA */}
            <span class="inline-flex items-center gap-2 text-sm font-bold transition-all duration-300
              group-hover:gap-3"
              style={`color: ${srv.color};`}>
              {txt.explorar}
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </span>
          </div>

          {/* Hover border glow */}
          <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
            style={`box-shadow: inset 0 0 0 1.5px ${srv.color}30;`}></div>

          {/* Gradient accent on hover */}
          <div class="absolute bottom-0 left-0 right-0 h-1 transform scale-x-0 group-hover:scale-x-100
            transition-transform duration-500 origin-left"
            style={`background: linear-gradient(to right, ${srv.color}, ${srv.color}60);`}></div>
        </a>
      ))}
    </div>

    {/* CTA bar */}
    <div class="pb-20 md:pb-28 pt-8">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-5 px-7 py-6 rounded-2xl
        bg-marca-azul dark:bg-slate-800/80">
        <p class="text-white text-sm sm:text-base font-medium text-center sm:text-left" style="font-family: 'Sora', sans-serif;">
          {txt.verTodos}
        </p>
        <div class="flex gap-3">
          <a href={rutas.servicios}
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm font-bold
              bg-white text-marca-azul hover:bg-slate-100
              transition-all duration-300"
            style="font-family: 'Sora', sans-serif;">
            {txt.explorar}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
          <a href={rutas.contacto}
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm font-semibold
              text-white/90 border border-white/20 hover:bg-white/10
              transition-all duration-300"
            style="font-family: 'Sora', sans-serif;">
            {txt.cotizar}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
