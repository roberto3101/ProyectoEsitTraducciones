---
import { obtenerTextos, obtenerRutas, type Idioma } from '../../helpers/idiomas';

interface Props { idioma: Idioma; }

const { idioma } = Astro.props;
const t = obtenerTextos(idioma);
const rutas = obtenerRutas(idioma);
---

<section class="cotizar" data-progreso>
  <div class="cotizar-foto" data-parallax="0.12">
    <picture>
      <source srcset="/imagenes/cta/escritorio.webp" type="image/webp" />
      <img src="/imagenes/cta/escritorio.jpg" alt="" width="2400" height="1029" loading="lazy" decoding="async" />
    </picture>
  </div>
  <div class="cotizar-velo"></div>

  <div class="contenedor cotizar-cuerpo">
    <div class="cotizar-texto" data-revelar>
      <h2 class="cotizar-titulo">{t.bannerCotizar.titulo}</h2>
      <p class="cotizar-bajada">{t.bannerCotizar.subtitulo}</p>
    </div>

    <a href={rutas.contacto} class="cotizar-boton" data-revelar>
      {t.bannerCotizar.boton}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>
</section>

<style>
  .cotizar {
    position: relative;
    isolation: isolate;
    overflow: clip;
    background-color: var(--navy-hondo);
  }

  .cotizar-foto {
    position: absolute;
    inset: -10% 0;
    z-index: 0;
    transform: translate3d(0, var(--desplazo, 0), 0);
    will-change: transform;
  }
  .cotizar-foto picture,
  .cotizar-foto img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .cotizar-foto img {
    object-fit: cover;
    /* Encuadrado a la izquierda: deja fuera el borde derecho de la toma */
    object-position: 30% 45%;
  }

  /* Velo funcional: sostiene la legibilidad del texto sobre la foto */
  .cotizar-velo {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to right, rgb(4 8 16 / 0.9) 0%, rgb(4 8 16 / 0.74) 45%, rgb(4 8 16 / 0.62) 100%);
  }

  .cotizar-cuerpo {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2.5rem;
    padding-block: clamp(5rem, 4rem + 6vw, 9rem);
  }

  @media (min-width: 900px) {
    .cotizar-cuerpo {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 4rem;
    }
  }

  .cotizar-titulo {
    font-size: var(--t-titulo);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: #fff;
    max-width: 18ch;
  }

  .cotizar-bajada {
    margin-top: 1.25rem;
    max-width: 42ch;
    font-size: var(--t-guia);
    line-height: 1.6;
    color: rgb(255 255 255 / 0.7);
  }

  .cotizar-boton {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
    padding: 1rem 1.75rem;
    border-radius: var(--radio);
    background-color: var(--papel);
    color: var(--navy);
    font-family: 'Sora', sans-serif;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color var(--ms-ui) var(--sale),
      transform var(--ms-rapido) var(--sale);
  }
  .cotizar-boton svg {
    width: 1.125rem;
    height: 1.125rem;
    transition: transform var(--ms-ui) var(--sale);
  }
  .cotizar-boton:hover {
    background-color: #fff;
  }
  .cotizar-boton:hover svg {
    transform: translateX(0.25rem);
  }
  .cotizar-boton:active {
    transform: translateY(1px);
  }
</style>
