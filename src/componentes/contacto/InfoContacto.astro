---
import { obtenerTextos, type Idioma } from '../../helpers/idiomas';
interface Props { idioma: Idioma; }
const { idioma } = Astro.props;

const textos: Record<string, Record<string, string>> = {
  titulo: { es: "Información de contacto", en: "Contact information", fr: "Informations de contact" },
  desc: {
    es: "Escríbanos o llámenos. Respondemos en menos de 24 horas.",
    en: "Write to us or call us. We respond within 24 hours.",
    fr: "Écrivez-nous ou appelez-nous. Nous répondons en moins de 24 heures."
  },
  telefonos: { es: "Teléfonos", en: "Phone numbers", fr: "Téléphones" },
  correos: { es: "Correo electrónico", en: "Email", fr: "E-mail" },
  direccion: { es: "Dirección", en: "Address", fr: "Adresse" },
  horario: { es: "Horario de atención", en: "Business hours", fr: "Heures d'ouverture" },
  horarioTexto: {
    es: "Lunes a Viernes, 9:00 – 18:00 (GMT-5)",
    en: "Monday to Friday, 9:00 AM – 6:00 PM (GMT-5)",
    fr: "Lundi à Vendredi, 9h00 – 18h00 (GMT-5)"
  },
  whatsapp: { es: "Escríbenos por WhatsApp", en: "Message us on WhatsApp", fr: "Écrivez-nous sur WhatsApp" },
  siguenos: { es: "Síguenos", en: "Follow us", fr: "Suivez-nous" },
};

const telefonos = [
  { numero: "+51 998 152 086", link: "tel:+51998152086" },
  { numero: "+51 998 122 941", link: "tel:+51998122941" },
  { numero: "+51 930 872 124", link: "tel:+51930872124" },
];

const correos = [
  { email: "contacto@esittraducciones.com", link: "mailto:contacto@esittraducciones.com" },
  { email: "info@esittraducciones.com", link: "mailto:info@esittraducciones.com" },
];

// PENDIENTE: Reemplazar # con URLs reales de redes sociales
const redes = [
  { nombre: "Facebook", url: "#",
    icono: '<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>' },
  { nombre: "Instagram", url: "#",
    icono: '<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>' },
  { nombre: "LinkedIn", url: "#",
    icono: '<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>' },
];
---

<div class="info">
  <div class="info-cabecera">
    <h3 class="info-titulo">{textos.titulo[idioma]}</h3>
    <p class="info-desc">{textos.desc[idioma]}</p>
  </div>

  <!-- Datos como lista de definiciones: la etiqueta manda, no un icono -->
  <dl class="info-datos">
    <div class="info-fila">
      <dt>{textos.telefonos[idioma]}</dt>
      <dd>
        {telefonos.map((tel) => (
          <a href={tel.link} class="info-enlace cifra">{tel.numero}</a>
        ))}
      </dd>
    </div>

    <div class="info-fila">
      <dt>{textos.correos[idioma]}</dt>
      <dd>
        {correos.map((c) => (
          <a href={c.link} class="info-enlace">{c.email}</a>
        ))}
      </dd>
    </div>

    <div class="info-fila">
      <dt>{textos.direccion[idioma]}</dt>
      <dd><p>Pueblo Libre, Lima – Perú</p></dd>
    </div>

    <div class="info-fila">
      <dt>{textos.horario[idioma]}</dt>
      <dd><p>{textos.horarioTexto[idioma]}</p></dd>
    </div>
  </dl>

  <a href="https://wa.me/51998152086" target="_blank" rel="noopener noreferrer" class="info-whatsapp">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
    {textos.whatsapp[idioma]}
  </a>

  <div class="info-redes">
    <p class="info-redes-titulo">{textos.siguenos[idioma]}</p>
    <div class="info-redes-lista">
      {redes.map((red) => (
        <a href={red.url} target="_blank" rel="noopener noreferrer" aria-label={red.nombre} class="info-red">
          <Fragment set:html={red.icono} />
        </a>
      ))}
    </div>
  </div>
</div>

<style>
  .info {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: clamp(1.75rem, 1.5rem + 1.5vw, 2.5rem);
    background-color: var(--fondo-hundido);
    border: 1px solid var(--borde);
    border-radius: var(--radio-grande);
  }

  .info-titulo {
    font-family: 'Sora', sans-serif;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.022em;
    color: var(--navy);
  }
  :global(.dark) .info-titulo {
    color: var(--texto);
  }

  .info-desc {
    margin-top: 0.5rem;
    max-width: 38ch;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--texto-medio);
  }

  .info-datos {
    margin-top: 2rem;
    flex: 1;
  }

  .info-fila {
    display: grid;
    gap: 0.25rem;
    padding-block: 1rem;
    border-top: 1px solid var(--borde);
  }

  @media (min-width: 420px) {
    .info-fila {
      grid-template-columns: 8.5rem 1fr;
      gap: 1rem;
      align-items: baseline;
    }
  }

  .info-fila dt {
    font-family: 'Sora', sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--texto-tenue);
  }

  .info-fila dd p {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--texto-medio);
  }

  .info-enlace {
    display: block;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--texto);
    text-decoration: none;
    transition: color var(--ms-ui) var(--sale);
  }
  .info-enlace:hover {
    color: var(--acento);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Verde de WhatsApp por reconocimiento de marca, sin halo de color */
  .info-whatsapp {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    margin-top: 2rem;
    padding-block: 0.875rem;
    border-radius: var(--radio);
    background-color: #128c7e;
    color: #fff;
    font-family: 'Sora', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color var(--ms-ui) var(--sale),
      transform var(--ms-rapido) var(--sale);
  }
  .info-whatsapp svg {
    width: 1.125rem;
    height: 1.125rem;
  }
  .info-whatsapp:hover {
    background-color: #0f7a6d;
  }
  .info-whatsapp:active {
    transform: translateY(1px);
  }

  .info-redes {
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--borde);
  }

  .info-redes-titulo {
    font-family: 'Sora', sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--texto-tenue);
  }

  .info-redes-lista {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.875rem;
  }

  .info-red {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--borde-marcado);
    border-radius: var(--radio);
    color: var(--texto-tenue);
    transition:
      color var(--ms-ui) var(--sale),
      border-color var(--ms-ui) var(--sale);
  }
  .info-red:hover {
    color: var(--texto);
    border-color: var(--texto-tenue);
  }
</style>