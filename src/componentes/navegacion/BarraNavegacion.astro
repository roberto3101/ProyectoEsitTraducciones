---
import Logo from './Logo.astro';
import SelectorIdioma from './SelectorIdioma.astro';
import { obtenerTextos, obtenerRutas, type Idioma } from '../../helpers/idiomas';
import { servicios, obtenerRutaServicio } from '../../datos/servicios';

interface Props {
  idioma: Idioma;
  paginaActual: string;
  /** En el inicio la barra flota transparente sobre la fotografia del hero */
  sobreHero?: boolean;
}

const { idioma, paginaActual, sobreHero = false } = Astro.props;
const textos = obtenerTextos(idioma);
const rutas = obtenerRutas(idioma);

const enlaces = [
  { nombre: textos.nav.inicio, ruta: rutas.inicio, clave: 'inicio' },
  { nombre: textos.nav.nosotros, ruta: rutas.nosotros, clave: 'nosotros' },
  { nombre: textos.nav.blog, ruta: rutas.blog, clave: 'blog' },
  { nombre: textos.nav.contacto, ruta: rutas.contacto, clave: 'contacto' },
];

const subServicios = servicios.map((srv) => ({
  nombre: srv.titulo[idioma],
  ruta: obtenerRutaServicio(srv, idioma),
  icono: srv.icono,
}));
---

<header class="barra" data-sobre-hero={sobreHero ? 'si' : 'no'} data-desplazada="no">
  <nav class="contenedor barra-fila" aria-label={textos.nav.inicio}>
    <Logo />

    <ul class="barra-lista">
      {enlaces.slice(0, 2).map((enlace) => (
        <li>
          <a
            href={enlace.ruta}
            class="barra-enlace"
            aria-current={paginaActual === enlace.clave ? 'page' : undefined}
          >
            {enlace.nombre}
          </a>
        </li>
      ))}

      <li class="barra-desplegable">
        <a
          href={rutas.servicios}
          class="barra-enlace barra-enlace-icono"
          aria-current={paginaActual === 'servicios' ? 'page' : undefined}
        >
          {textos.nav.servicios}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>

        <div class="barra-panel">
          <ul>
            {subServicios.map((sub) => (
              <li>
                <a href={sub.ruta} class="barra-panel-item">
                  <span class="barra-panel-icono" set:html={sub.icono.replace('w-8 h-8', 'w-4 h-4')} />
                  <span>{sub.nombre}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </li>

      {enlaces.slice(2).map((enlace) => (
        <li>
          <a
            href={enlace.ruta}
            class="barra-enlace"
            aria-current={paginaActual === enlace.clave ? 'page' : undefined}
          >
            {enlace.nombre}
          </a>
        </li>
      ))}
    </ul>

    <div class="barra-acciones">
      <SelectorIdioma idioma={idioma} />

      <button id="btn-tema" class="barra-icono" aria-label="Cambiar tema" type="button">
        <svg class="icono-sol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke-linecap="round" />
        </svg>
        <svg class="icono-luna" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M20.4 15.4A8.5 8.5 0 018.6 3.6a8.5 8.5 0 1011.8 11.8z" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>

      <a href={rutas.contacto} class="boton-principal barra-cotizar">{textos.nav.cotizar}</a>

      <button
        id="btn-menu"
        class="barra-icono barra-hamburguesa"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="menu-movil"
        type="button"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </nav>

  <div class="progreso" aria-hidden="true"></div>

  <div id="menu-movil" class="menu-movil" hidden>
    <ul class="contenedor">
      {enlaces.slice(0, 2).map((enlace) => (
        <li>
          <a href={enlace.ruta} class="menu-movil-enlace" aria-current={paginaActual === enlace.clave ? 'page' : undefined}>
            {enlace.nombre}
          </a>
        </li>
      ))}

      <li>
        <button
          id="btn-servicios-movil"
          class="menu-movil-enlace menu-movil-boton"
          aria-expanded="false"
          aria-controls="submenu-servicios-movil"
          type="button"
        >
          {textos.nav.servicios}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <ul id="submenu-servicios-movil" class="menu-movil-sub" hidden>
          <li>
            <a href={rutas.servicios} class="menu-movil-sub-enlace">{textos.nav.servicios}</a>
          </li>
          {subServicios.map((sub) => (
            <li>
              <a href={sub.ruta} class="menu-movil-sub-enlace">{sub.nombre}</a>
            </li>
          ))}
        </ul>
      </li>

      {enlaces.slice(2).map((enlace) => (
        <li>
          <a href={enlace.ruta} class="menu-movil-enlace" aria-current={paginaActual === enlace.clave ? 'page' : undefined}>
            {enlace.nombre}
          </a>
        </li>
      ))}

      <li class="menu-movil-cta">
        <a href={rutas.contacto} class="boton-principal">{textos.nav.cotizar}</a>
      </li>
    </ul>
  </div>
</header>

<style>
  .barra-fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 4.5rem;
  }

  @media (min-width: 1024px) {
    .barra-fila { height: 5rem; }
  }

  .barra-lista {
    display: none;
    align-items: center;
    gap: 2rem;
    list-style: none;
  }
  @media (min-width: 1024px) {
    .barra-lista { display: flex; }
  }

  .barra-enlace-icono {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .barra-enlace-icono svg {
    width: 0.875rem;
    height: 0.875rem;
    transition: transform var(--ms-ui) var(--sale);
  }
  .barra-desplegable:hover .barra-enlace-icono svg {
    transform: rotate(180deg);
  }

  /* --- Panel de servicios --- */
  .barra-desplegable { position: relative; }

  .barra-panel {
    position: absolute;
    top: 100%;
    left: 50%;
    margin-top: 0.75rem;
    width: 17rem;
    translate: -50% 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-0.375rem);
    background-color: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    box-shadow: var(--sombra-menu);
    padding: 0.375rem;
    transition:
      opacity var(--ms-ui) var(--sale),
      transform var(--ms-ui) var(--sale),
      visibility var(--ms-ui);
  }
  .barra-desplegable:hover .barra-panel,
  .barra-desplegable:focus-within .barra-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .barra-panel ul { list-style: none; }

  .barra-panel-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 0.75rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--texto-medio);
    text-decoration: none;
    transition:
      background-color var(--ms-rapido) var(--sale),
      color var(--ms-rapido) var(--sale);
  }
  .barra-panel-item:hover {
    background-color: var(--fondo-hundido);
    color: var(--texto);
  }

  .barra-panel-icono {
    display: inline-flex;
    color: var(--texto-tenue);
  }

  /* --- Acciones --- */
  .barra-acciones {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .barra-icono svg { width: 1.25rem; height: 1.25rem; }

  .icono-sol { display: none; }
  :global(.dark) .icono-sol { display: block; }
  :global(.dark) .icono-luna { display: none; }

  .barra-cotizar {
    display: none;
    margin-left: 0.25rem;
  }
  @media (min-width: 768px) {
    .barra-cotizar { display: inline-flex; }
  }

  .barra-hamburguesa { display: inline-flex; }
  @media (min-width: 1024px) {
    .barra-hamburguesa { display: none; }
  }

  /* Sobre el hero los botones cambian de traje */
  .barra[data-sobre-hero='si']:not([data-desplazada='si']) .barra-cotizar {
    background-color: rgb(255 255 255 / 0.12);
    color: #fff;
    border-color: rgb(255 255 255 / 0.2);
    backdrop-filter: blur(8px);
  }
  .barra[data-sobre-hero='si']:not([data-desplazada='si']) .barra-cotizar:hover {
    background-color: rgb(255 255 255 / 0.2);
  }

  /* --- Menu movil --- */
  .menu-movil {
    border-top: 1px solid var(--borde);
    background-color: var(--fondo);
    max-height: calc(100svh - 4.5rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .menu-movil ul { list-style: none; }
  .menu-movil > ul { padding-block: 0.75rem 1.5rem; }

  .menu-movil-enlace {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.875rem 0;
    font-family: 'Sora', sans-serif;
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--texto);
    text-decoration: none;
    border-bottom: 1px solid var(--borde);
    text-align: left;
  }
  .menu-movil-enlace[aria-current='page'] { color: var(--acento); }
  .menu-movil-boton svg {
    width: 1.125rem;
    height: 1.125rem;
    color: var(--texto-tenue);
    transition: transform var(--ms-ui) var(--sale);
  }
  .menu-movil-boton[aria-expanded='true'] svg { transform: rotate(180deg); }

  .menu-movil-sub {
    padding: 0.5rem 0 0.75rem 1rem;
    border-left: 1px solid var(--borde);
    margin-left: 0.25rem;
  }
  .menu-movil-sub-enlace {
    display: block;
    padding: 0.5rem 0;
    font-size: 0.9375rem;
    color: var(--texto-medio);
    text-decoration: none;
  }
  .menu-movil-sub-enlace:hover { color: var(--texto); }

  .menu-movil-cta { padding-top: 1.5rem; }
  .menu-movil-cta .boton-principal { width: 100%; }
</style>
