# ============================================================
# PLANTILLA DE VARIABLES DE ENTORNO — ESIT Traducciones
#
# Copiar este archivo como `.env` y rellenar los valores.
# NUNCA subir el `.env` real al repositorio (ya esta en .gitignore).
#
# Guia completa con enlaces: ver CREDENCIALES.md
# ============================================================


# --- SANITY (gestor de contenidos del blog) -----------------
# Panel: https://www.sanity.io/manage
# El projectId y el dataset son identificadores publicos.
# El TOKEN es secreto: da acceso de lectura al contenido.
SANITY_PROJECT_ID=rh87j8bk
SANITY_DATASET=production
SANITY_API_VERSION=2026-01-01
SANITY_TOKEN=


# --- GOOGLE ANALYTICS 4 (trafico y conversiones) ------------
# Panel: https://analytics.google.com
# Admin > Flujos de datos > seleccionar el sitio > "ID de medicion"
# Formato: G-XXXXXXXXXX
PUBLIC_GA_MEASUREMENT_ID=


# --- MICROSOFT CLARITY (mapas de calor y grabaciones) -------
# Panel: https://clarity.microsoft.com
# Settings > Overview > "Project ID"
# Si se deja vacio, el script no se carga. Gratis y sin limite.
PUBLIC_CLARITY_ID=


# --- HUBSPOT (CRM: formulario de contacto -> leads) ---------
# Panel: https://app.hubspot.com
# Marketing > Forms > abrir el formulario > Compartir > Insertar
# Ambos valores aparecen en el codigo de insercion.
# Si se dejan vacios, el formulario simula exito y NO crea leads.
PUBLIC_HUBSPOT_PORTAL_ID=
PUBLIC_HUBSPOT_FORM_ID=


# --- FAL.AI (generacion de imagenes, solo desarrollo) -------
# Panel: https://fal.ai/dashboard/keys
# No hace falta en produccion. Solo se usa al generar fotografia
# con `scripts/` durante el diseno.
FAL_KEY=
